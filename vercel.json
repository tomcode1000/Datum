{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "ui",
  "functions": {
    "api/*.py": {
      "maxDuration": 30,
      "includeFiles": "{oracle/**,panel.json,pools.json}"
    }
  },
  "rewrites": [
    {
      "source": "/api/quote/:ticker",
      "destination": "/api/quote?ticker=:ticker"
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)runs'"
}
